# =============================================================================
# Compose environment — variable substitution for docker-compose.yml
#
# Strategy:
#   .env          -> read automatically by `docker compose` (DO NOT COMMIT)
#   .env.example  -> this template (committed)
#   .env.prod     -> production secrets, used via: docker compose --env-file .env.prod ...
#
# Copy and fill before first run:
#   cp .env.example .env
# Generate strong secrets:
#   openssl rand -hex 32
# =============================================================================

# --- Profile / mode ---
ENVIRONMENT=development            # development | production
IMAGE_TAG=latest

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432                 # host-side, bound to 127.0.0.1 only

# --- Redis ---
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_PORT=6379                    # host-side, bound to 127.0.0.1 only

# --- API ---
API_PORT=8000
API_WORKERS=4                      # production worker count
JWT_SECRET=change-me-32-byte-hex-secret
OTP_PEPPER=change-me-32-byte-hex-pepper
SMS_PROVIDER=console               # console | kavenegar | smsir
DEFAULT_LOCALE=fa-IR
CORS_ORIGINS=["http://localhost:3000"]

# --- pgAdmin (dev profile only) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-pgadmin-password
PGADMIN_PORT=5050
