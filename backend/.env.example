# Copy to .env and adjust. Never commit real secrets.
ENVIRONMENT=development
DEBUG=true

# App uses asyncpg; Alembic uses the sync URL below.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/ecommerce
# For Alembic CLI: export DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/ecommerce

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=please-change-me
OTP_PEPPER=please-change-me-too

SMS_PROVIDER=console
DEFAULT_LOCALE=fa-IR
