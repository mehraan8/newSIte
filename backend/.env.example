# =============================================================================
# Copy to .env and adjust. Never commit real secrets.
#
# CREDENTIALS DO NOT LIVE HERE. POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# / REDIS_PASSWORD / JWT_SECRET / OTP_PEPPER come from the repo-root .env — the
# same file docker compose reads — and src/config/env_bootstrap.py derives
# DATABASE_URL, TEST_DATABASE_URL and REDIS_URL from them. Do not hand-write a
# DSN here; it will drift from what Postgres was actually initialised with.
#
# Precedence: real process env  >  this file  >  repo-root .env
# =============================================================================

DEBUG=true

# Reaching the containers from the host.
#
# 127.0.0.1, NOT localhost. Compose publishes these on 127.0.0.1 only, while
# Windows resolves `localhost` to ::1 first — so every connection stalls ~2s on
# a dead IPv6 attempt before falling back to IPv4. The integration suite uses
# NullPool (a fresh connection per statement), which turned that into minutes.
POSTGRES_HOST=127.0.0.1
REDIS_HOST=127.0.0.1

# Scratch database for tests/integration. The suite TRUNCATEs it between tests,
# so it must never be POSTGRES_DB. Created automatically on first run.
# Defaults to <POSTGRES_DB>_test; uncomment only to override.
# POSTGRES_TEST_DB=ecommerce_test
